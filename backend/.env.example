PORT=8080
ENV=development

# Banco de dados (driver: sqlite ou postgres)
DB_DRIVER=sqlite
DB_SOURCE=javiessefilme.db

# Chave secreta da sessão (mínimo de 32 caracteres em produção)
SESSION_SECRET=javiessefilme-super-secret-key-32bytes-min

# Frontend URL (para liberar no CORS)
FRONTEND_URL=http://localhost:5173

# Chave opcional do The Movie Database (TMDB) para capas, elenco e sinopses
TMDB_API_KEY=

# Chaves Web Push (VAPID) para envio de notificações aos navegadores
VAPID_PUBLIC_KEY=Insira_aqui_sua_chave_publica_VAPID
VAPID_PRIVATE_KEY=Insira_aqui_sua_chave_privada_VAPID
VAPID_SUBJECT=mailto:suporte@javiessefilme.app
CRON_SECRET=token-secreto-para-lembretes
